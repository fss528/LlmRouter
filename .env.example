# Copy this file to your shell/profile/secret store and fill only the providers you want to test.
# Never commit real API keys.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Demo Mode (runs simulated providers without paid API keys)
# DemoMode__Enabled=true

# Optional Distributed State Store (Redis)
# StateStore__Provider=Redis
# ConnectionStrings__Redis=localhost:6379

# Optional OpenTelemetry OTLP Exporter
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889

# Optional Gateway API Key Protection (comma-separated indices or Gateway__ApiKeys__0)
# Gateway__ApiKeys__0=your-gateway-client-key
