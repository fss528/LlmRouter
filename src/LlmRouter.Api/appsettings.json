{
  "Providers": {
    "RequestTimeoutSeconds": 30,
    "HealthCheckEnabled": true,
    "HealthCheckIntervalSeconds": 30,
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": ""
    },
    "OpenAI": {
      "BaseUrl": "https://api.openai.com",
      "ApiKey": ""
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "ApiKey": ""
    }
  },
  "Routing": {
    "IncludeDefaults": true
  },
  "StateStore": {
    "Provider": "InMemory",
    "KeyPrefix": "llmrouter:health"
  },
  "DemoMode": {
    "Enabled": false,
    "AnthropicLatencyMs": 210,
    "OpenAiLatencyMs": 135,
    "GeminiLatencyMs": 85
  },
  "Gateway": {
    "ApiKeys": [],
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
